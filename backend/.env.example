# SQLite is used for local development. Set USE_SQLITE=false and provide all
# PostgreSQL connection values below when using a PostgreSQL database.
USE_SQLITE=true
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
# Root hosting remains the default. The proxy must strip this prefix before forwarding to Django.
APP_BASE_PATH=/
# Required only when using DJANGO_SETTINGS_MODULE=backend.production_settings:
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=vanitatech.co.uk
# Origins only, without a path. Empty is sufficient for same-origin React/API requests.
DJANGO_ALLOWED_ORIGINS=
# Enable only behind a trusted proxy that replaces X-Forwarded-Proto; bind Gunicorn to loopback.
DJANGO_TRUST_PROXY=false
